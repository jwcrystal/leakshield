# Dependencies and build output
node_modules/
/dist/
/build/
*.tsbuildinfo

# Test output and captured runtime evidence
coverage/
.vitest/
/scripts/e2e/out/

# Local environment and private keys
# Local scanner config (start from config/guard.config.example.yaml)
/config/guard.config.yaml
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local agent state, worktrees and scratch data
/.opencode/
/.claude/
/.omc/
/.gitnexus/
/.scratch/
/.ptmp*

# Generated release archives and executables
/leakshield
/leakshield.exe
/leakshield-linux
/leakshield-intel
/leakshield*.zip
/leakshield*.tgz
*.app/

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# bun.lock is intentionally not tracked: npm (package-lock.json) is the
# package manager of record; bun is only used for `binary:*` compile builds,
# which do not read a lockfile.
bun.lock
