{
  "name": "leakshield",
  "version": "0.3.1",
  "description": "OpenCode plugin, pi adapter, CLI, and web scanner for sensitive content before sending it to AI",
  "license": "Apache-2.0",
  "author": "Jared Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwcrystal/leakshield.git"
  },
  "bugs": {
    "url": "https://github.com/jwcrystal/leakshield/issues"
  },
  "homepage": "https://github.com/jwcrystal/leakshield#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pi-package",
    "secrets",
    "pii",
    "redaction",
    "pseudonymization",
    "llm",
    "security"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./pi": {
      "types": "./dist/pi/extension.d.ts",
      "default": "./dist/pi/extension.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "leakshield": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "start": "node dist/cli.js --cli",
    "dev": "tsx src/cli.ts --cli",
    "scan": "tsx src/cli.ts --cli",
    "web": "tsx src/cli.ts --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "binary": "bun build --compile --target=bun-darwin-arm64 ./src/cli.ts --outfile=leakshield",
    "binary:win": "bun build --compile --target=bun-windows-x64 ./src/cli.ts --outfile=leakshield.exe",
    "binary:win-icon": "node scripts/build-win.js",
    "binary:linux": "bun build --compile --target=bun-linux-x64 ./src/cli.ts --outfile=leakshield-linux",
    "binary:mac-intel": "bun build --compile --target=bun-darwin-x64 ./src/cli.ts --outfile=leakshield-intel",
    "binary:all": "npm run binary && npm run binary:win && npm run binary:linux && npm run binary:mac-intel",
    "bundle:mac": "npm run binary && bash scripts/bundle-mac.sh"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@opencode-ai/sdk": "^1.17.18",
    "@opencode/plugin": "^2.0.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "rcedit": "^5.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  }
}
