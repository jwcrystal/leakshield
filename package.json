{
  "name": "sensitive-guard",
  "version": "1.0.0",
  "description": "MCP Server + CLI: Sensitive content scanner before sending to AI",
  "type": "module",
  "bin": {
    "sensitive-guard": "./dist/index.js"
  },
  "scripts": {
